{
  "name": "wybix-pos",
  "version": "1.2.0",
  "main": "electron/main.js",
  "scripts": {
    "build": "ng build --configuration production --base-href ./",
    "electron": "electron ./electron/main.js",
    "start": "npm run build && npm run electron",
    "start:ng": "ng serve",
    "start:electron": "cross-env NODE_ENV=development electronmon ./electron/main.js",
    "dev": "concurrently -k \"npm run start:ng\" \"wait-on http://localhost:4200 && npm run start:electron\"",
    "pack": "npm run db:check-template && electron-builder --dir",
    "dist": "npm run db:check-template && npm run build && electron-builder",
    "publish": "npm run db:check-template && npm run build && electron-builder --publish always",
    "db:extract": "node scripts/db/extraer.mjs",
    "db:extract-schema": "node scripts/db/extraer-esquema.mjs",
    "db:verify": "node scripts/db/verificar.mjs",
    "db:migration": "node scripts/db/generar-migracion.mjs",
    "db:test-migration": "node scripts/db/probar-migracion.mjs",
    "db:compare-schema": "node scripts/db/comparar-esquema.mjs",
    "db:test-rebuild": "node scripts/db/probar-reconstruccion.mjs",
    "db:baseline": "node scripts/db/construir-baseline.mjs",
    "db:test-install": "node scripts/db/probar-instalacion.mjs",
    "db:apply": "node scripts/db/aplicar-migraciones.mjs",
    "db:test-hospitality": "node scripts/db/probar-migracion.mjs --conservar && node scripts/db/pruebas/dominio-hospitality.mjs && node scripts/db/pruebas/venta-hospitality.mjs && node scripts/db/pruebas/concurrencia.mjs && node scripts/db/pruebas/receta-efectiva.mjs && node scripts/db/pruebas/receta-por-variante.mjs",
    "db:test-setup": "node scripts/db/pruebas/setup-inicial.mjs",
    "db:test-latte": "node scripts/db/pruebas/latte.mjs",
    "db:test-baja": "node scripts/db/pruebas/baja-producto.mjs",
    "db:test-turno": "node scripts/db/pruebas/turno.mjs",
    "db:test-compras": "node scripts/db/pruebas/compras.mjs",
    "db:test-bebidas": "node scripts/db/pruebas/bebidas.mjs",
    "db:test-alertas": "node scripts/db/pruebas/alertas.mjs",
    "db:test-upgrade": "node scripts/db/pruebas/upgrade.mjs",
    "db:test-cajas": "node scripts/db/pruebas/cajas.mjs",
    "db:test-fidelizacion": "node scripts/db/pruebas/fidelizacion.mjs",
    "db:test-fidelizacion-multicaja": "node scripts/db/pruebas/fidelizacion-multicaja.mjs",
    "db:test-fidelizacion-cupones": "node scripts/db/pruebas/fidelizacion-cupones.mjs",
    "db:test-fidelizacion-horarios": "node scripts/db/pruebas/fidelizacion-horarios.mjs",
    "db:test-rol": "node scripts/db/pruebas/rol-aplicacion.mjs",
    "db:test-variante": "node scripts/db/pruebas/receta-por-variante.mjs",
    "db:test-receta-efectiva": "node scripts/db/pruebas/receta-efectiva.mjs",
    "db:diagnose": "electron scripts/db/diagnosticar-migracion.js",
    "db:test-backup": "node scripts/db/probar-respaldo.mjs",
    "db:check-template": "node scripts/db/verificar-template.mjs",
    "db:prepare-release": "npm run db:baseline && npm run db:check-template -- --a-fondo && npm run db:test-install",
    "test:marca": "node scripts/pruebas/customer-display-marca.mjs",
    "test:capas": "node scripts/pruebas/capas.mjs",
    "test:ipc": "node scripts/pruebas/auditar-ipc.mjs",
    "test:trial": "node scripts/pruebas/licencia-prueba.mjs",
    "test:ticket": "node scripts/pruebas/ticket.mjs",
    "test:licencia": "node scripts/pruebas/licencia-huella.mjs && node scripts/pruebas/licencia-almacen.mjs",
    "test:red": "node scripts/pruebas/red-principal.mjs",
    "test:servidor": "node scripts/pruebas/servidor-sql.mjs",
    "test:pool": "node scripts/pruebas/pool-ciclo-vida.mjs",
    "test:arranque": "node scripts/pruebas/arranque-secundaria.mjs",
    "test:opciones": "node scripts/pruebas/opciones-linea.mjs",
    "test:multicaja": "node scripts/pruebas/servidor-sql.mjs && node scripts/pruebas/pool-ciclo-vida.mjs && node scripts/pruebas/arranque-secundaria.mjs && node scripts/pruebas/red-principal.mjs && node scripts/db/pruebas/cajas.mjs && node scripts/db/pruebas/rol-aplicacion.mjs"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "build": {
    "appId": "com.wybix.pos",
    "productName": "Wybix POS",
    "artifactName": "Wybix-Setup.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "electron/assets"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/node_modules",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/templates",
        "to": "templates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "installer/sqlexpress",
        "to": "sqlexpress"
      },
      {
        "from": "installer/ConfigurationFile.ini",
        "to": "ConfigurationFile.ini"
      },
      {
        "from": "installer/setup-sqlserver.ps1",
        "to": "setup-sqlserver.ps1"
      },
      {
        "from": "installer/preparar-red.ps1",
        "to": "preparar-red.ps1"
      },
      {
        "from": "installer/template.bak",
        "to": "template.bak"
      },
      {
        "from": "installer/sqlupdates",
        "to": "sqlupdates",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "installer/sql-servicing.json",
        "to": "sql-servicing.json"
      },
      {
        "from": "electron/assets",
        "to": "assets",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "electron/migrations",
        "to": "migrations",
        "filter": [
          "**/*.sql"
        ]
      },
      {
        "from": "sql/permissions",
        "to": "permissions",
        "filter": [
          "**/*.sql"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/assets/wybix_logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Wybix POS",
      "installerIcon": "electron/assets/wybix_logo.ico",
      "uninstallerIcon": "electron/assets/wybix_logo.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "DavidCa25",
      "repo": "POS_Hidromec"
    }
  },
  "dependencies": {
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/web": "^2.1.2",
    "apexcharts": "^4.7.0",
    "bootstrap": "^5.3.2",
    "dotenv": "^17.2.1",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.6.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4",
    "msnodesqlv8": "^5.1.3",
    "mssql": "^11.0.1",
    "ng-apexcharts": "^1.16.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "serialport": "^13.0.0",
    "sweetalert2": "^11.22.3",
    "tslib": "^2.3.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.4",
    "@angular/cli": "^20.0.4",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jasmine": "~5.1.0",
    "@types/qrcode": "^1.5.6",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "electron": "^37.1.0",
    "electron-builder": "^26.0.12",
    "electron-reload": "^2.0.0-alpha.1",
    "electronmon": "^2.0.3",
    "jasmine-core": "~5.7.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.8.2",
    "wait-on": "^8.0.4"
  }
}
